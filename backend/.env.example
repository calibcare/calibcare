# PORT is provided automatically by Railway at runtime -- do not set it
# manually there. Only needed locally, where it defaults to 3001 anyway.
PORT=3001

# Database. Locally these default to a passwordless local MySQL on the
# default port. On Railway, set all five explicitly from the MySQL plugin's
# connection details (Railway's MySQL is not on port 3306, so DB_PORT must
# be set there).
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=mcems

# Auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=30d

# The deployed frontend's origin (e.g. https://your-site.netlify.app), used
# to restrict CORS. Left unset, any origin is allowed -- fine for local dev,
# must be set once this is actually deployed.
FRONTEND_URL=

# LINE Official Account (Messaging API). Leave blank to run reminder checks
# in dry-run mode (logs what it would send, sends nothing).
LINE_CHANNEL_ACCESS_TOKEN=

# Channel secret from the LINE Developers Console "Basic settings" tab.
# Required to verify that webhook requests genuinely came from LINE.
LINE_CHANNEL_SECRET=

# Optional: your OA's Basic ID (e.g. "@abc1234", shown in LINE Developers
# Console / LINE Official Account Manager). If set, the frontend's "Connect
# LINE" flow shows a direct add-friend link.
LINE_OA_BASIC_ID=

# Note: there is no REMINDER_CRON variable anymore -- the daily reminder
# check moved from an in-process node-cron scheduler to a standalone script
# (scripts/checkNotifications.js) meant to be run on a schedule by the
# hosting platform itself (e.g. a Railway Cron Job service), not by the app.
